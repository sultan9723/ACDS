diff --git a/backend/core/rate_limit.py b/backend/core/rate_limit.py
new file mode 100644
index 0000000..dc04c9c
--- /dev/null
+++ b/backend/core/rate_limit.py
@@ -0,0 +1,23 @@
+"""
+Shared rate limiter instance.
+
+Kept in its own module (rather than defined in main.py) so route modules
+like api/routes/auth.py can import and apply @limiter.limit(...) to specific
+endpoints without a circular import back to main.py.
+"""
+try:
+    from slowapi import Limiter
+    from slowapi.util import get_remote_address
+    RATE_LIMITING_AVAILABLE = True
+    limiter = Limiter(key_func=get_remote_address, default_limits=["200/hour"])
+except ImportError:
+    RATE_LIMITING_AVAILABLE = False
+
+    class _NoOpLimiter:
+        """Fallback so `@limiter.limit(...)` is a harmless no-op if slowapi isn't installed."""
+        def limit(self, *_args, **_kwargs):
+            def decorator(func):
+                return func
+            return decorator
+
+    limiter = _NoOpLimiter()

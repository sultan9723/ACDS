+# publicly-reachable demo instance) from being hammered. Per-IP, in-memory by
+# default; point slowapi at Redis via storage_uri if you need it to survive
+# restarts / work across multiple backend instances.
+if RATE_LIMITING_AVAILABLE:
+    app.state.limiter = limiter
+    app.add_exception_handler(RateLimitExceeded, _rate_limit_exceeded_handler)
+

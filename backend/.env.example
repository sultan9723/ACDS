# ACDS backend local development environment
# Do not commit real secrets. Replace these values in backend/.env.

# Development-only example secret. Use a unique long random value locally.
JWT_SECRET_KEY=replace-with-a-long-random-local-development-secret

# Optional local phishing test-run dataset. Supports CSV, JSON, JSONL.
# Expected columns can include content/body/text/email_text plus label/is_phishing.
# PHISHING_TEST_DATASET_PATH=backend/data/phishing_dataset.csv

# Optional one-time admin bootstrap for an empty local database.
# Keep disabled after the first admin user is provisioned.
BOOTSTRAP_ADMIN_ENABLED=false
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
